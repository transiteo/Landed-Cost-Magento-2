<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/consumer.xsd">
    <consumer name="transiteo.sync.order"
              queue="transiteo.sync.order"
              handler="Transiteo\LandedCost\Model\Sync\OrderSyncHandler::process"
              onlySpawnWhenMessageAvailable="1"
    />
    <consumer name="transiteo.sync.product"
              queue="transiteo.sync.product"
              handler="Transiteo\LandedCost\Model\Sync\ProductSyncHandler::process"
              onlySpawnWhenMessageAvailable="1"
    />
    <consumer name="transiteo.sync.category"
              queue="transiteo.sync.category"
              handler="Transiteo\LandedCost\Model\Sync\CategorySyncHandler::process"
              onlySpawnWhenMessageAvailable="1"
    />
    <consumer name="transiteo.sync.seller"
              queue="transiteo.sync.seller"
              handler="Transiteo\LandedCost\Model\Sync\SellerSyncHandler::process"
              onlySpawnWhenMessageAvailable="1"
    />
</config>
