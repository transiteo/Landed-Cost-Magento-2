<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/topology.xsd">
    <exchange name="transiteo.sync">
        <binding id="transiteoSyncOrder"
                 topic="transiteo.sync.order"
                 destination="transiteo.sync.order"
                 destinationType="queue"/>
        <binding id="transiteoSyncProduct"
                 topic="transiteo.sync.product"
                 destination="transiteo.sync.product"
                 destinationType="queue"/>
        <binding id="transiteoSyncCategory"
                 topic="transiteo.sync.category"
                 destination="transiteo.sync.category"
                 destinationType="queue"/>
        <binding id="transiteoSyncSeller"
                 topic="transiteo.sync.seller"
                 destination="transiteo.sync.seller"
                 destinationType="queue"/>
    </exchange>
</config>
