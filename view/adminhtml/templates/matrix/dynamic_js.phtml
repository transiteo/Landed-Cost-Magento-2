<?php
    $viewModel = $this->getViewModel();
    $json = json_encode($viewModel->getCountriesUrl());
?>
<script>
    require(['jquery'], function ($) {
        $(document).ready(function () {
            const syncOptions = <?= $json ?>;
            const dropdownId = 'categorySyncDropdownMenu';

            // Si le menu n'existe pas, le créer
            let $menu = $('#' + dropdownId);
            if (!$menu.length) {
                $menu = $('<ul/>', {
                    id: dropdownId,
                    class: 'admin__action-dropdown',
                    css: {
                        display: 'none',
                        position: 'absolute',
                        'z-index': 1000,
                        background: '#fff',
                        border: '1px solid #ccc',
                        padding: 0,
                        margin: 0,
                        'list-style': 'none',
                        width: '180px'
                    }
                }).appendTo('body');
            }

            $(document).on('click', '#categorySyncDropdownToggle', function (e) {
                e.preventDefault();

                if ($menu.is(':visible')) {
                    $menu.hide();
                    return;
                }

                // Positionnement du menu
                const offset = $('#categorySyncDropdownToggle').offset();
                $menu.css({
                    top: offset.top + $('#categorySyncDropdownToggle').outerHeight(),
                    left: offset.left
                });

                // Construction des éléments du dropdown
                $menu.empty();
                syncOptions.forEach(option => {
                    $('<li/>', { class: 'admin__action-dropdown-menu-item' })
                        .append(
                            $('<a/>', {
                                class: 'action-menu-item',
                                href: option.url,
                                text: option.iso_code,
                                css: {
                                    display: 'block',
                                    padding: '8px 12px',
                                    color: '#333',
                                    'text-decoration': 'none'
                                }
                            }).hover(
                                function () { $(this).css('background', '#f5f5f5'); },
                                function () { $(this).css('background', 'transparent'); }
                            )
                        ).appendTo($menu);
                });

                $menu.show();
            });

            // Masquer si clic à l’extérieur
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#' + dropdownId + ', #categorySyncDropdownToggle').length) {
                    $menu.hide();
                }
            });
        });
    });

</script>
