    <body>
        <referenceContainer name="content">
            <uiComponent name="transiteo_categorymatrix_listing"/>

            <block class="Magento\Framework\View\Element\Template"
                   name="transiteo.dynamic.js"
                   template="Transiteo_LandedCost::matrix/dynamic_js.phtml">
